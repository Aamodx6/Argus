# Nuance SageMaker Multimodal Inference Service Environment Variables

# AWS Configuration (Locked to project selected region ap-southeast-2)
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# SageMaker Endpoint Names
SAGEMAKER_ENDPOINT_NAME=sagemaker-multimodal-sentiment-v2
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole

# S3 Buckets for Video Ingest and Artifact Storage
S3_BUCKET_NAME=nuance-video-sentiment-inference-ap-southeast-2
S3_PREFIX=uploads/

# Model Execution Parameters
MODEL_FRAME_RATE=30
FACE_DETECTION_CONFIDENCE=0.85
WHISPER_MODEL_SIZE=base
MAX_VIDEO_DURATION_SECONDS=300
BATCH_SIZE=8
