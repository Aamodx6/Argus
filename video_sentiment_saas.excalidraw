      "versionNonce": 1963351334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794895092219,
      "link": null,
      "locked": false,
      "text": "Reduces learning rate by 1/10 if it doesn't improve for 2 epochs\nGradient descent can now be done with smaller steps, to get closer\nto the minima",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reduces learning rate by 1/10 if it doesn't improve for 2 epochs\nGradient descent can now be done with smaller steps, to get closer\nto the minima",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794895088354,
      "labelPosition": null,
      "baseFontSize": null
    },
