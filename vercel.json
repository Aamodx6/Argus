{
  "services": {
    "app": {
      "framework": "nextjs",
      "root": "apps/app"
    },
    "web": {
      "framework": "astro",
      "root": "apps/web"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
