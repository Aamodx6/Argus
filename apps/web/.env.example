# Argus Web (Astro) Environment Variables

# Public Base URL
PUBLIC_SITE_URL=http://localhost:4321

# SaaS API Gateway / Backend URL
PUBLIC_API_URL=http://localhost:3000

# Match REQUIRE_MODERATION on apps/app; keep enabled for public uploads.
PUBLIC_REQUIRE_MODERATION=1

# Razorpay Standard Checkout (public Key ID only - never add KEY_SECRET here)
PUBLIC_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_ID=
