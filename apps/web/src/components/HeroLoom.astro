---
// HeroLoom Component: Headline + Interactive Loom Cloth Simulation
---

<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Column: Copy & Actions -->
      <div class="hero-copy">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Live weaving · 240+ connectors</span>
        </div>

        <h1 class="hero-title">
          Ninety tools in.<br />
          <span class="highlight">One answer out.</span>
        </h1>

        <p class="hero-lede">
          Warpyn connects your billing, CRM, product and support data, then answers questions in plain English. Every figure is woven from rows you can trace.
        </p>

        <div class="hero-cta-group">
          <a href="/#pricing" class="btn-primary">
            Start weaving
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/product" class="btn-secondary">
            See the product
          </a>
        </div>

        <div class="hero-metrics-strip">
          <div class="metric-item">
            <span class="metric-val">16×</span>
            <span class="metric-lbl">Faster than tickets</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">47%</span>
            <span class="metric-lbl">Fewer dashboards</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">100%</span>
            <span class="metric-lbl">Traced to rows</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Loom Cloth -->
      <div class="loom-container" id="loomInteractiveContainer">
        <!-- Canvas simulation -->
        <canvas id="loomCanvas" class="loom-canvas"></canvas>

        <!-- Floating Source Nodes (Left of Loom) -->
        <div class="source-nodes">
          <div class="source-node" style="--c: #383830">
            <span class="node-dot"></span>
            <span class="node-name">Product events</span>
            <span class="node-sub">sessions</span>
          </div>
          <div class="source-node" style="--c: #252A36">
            <span class="node-dot"></span>
            <span class="node-name">Ad spend</span>
            <span class="node-sub">campaigns</span>
          </div>
          <div class="source-node" style="--c: #20232A">
            <span class="node-dot"></span>
            <span class="node-name">Billing</span>
            <span class="node-sub">invoices</span>
          </div>
          <div class="source-node" style="--c: #1C1E23">
            <span class="node-dot"></span>
            <span class="node-name">HR system</span>
            <span class="node-sub">headcount</span>
          </div>
          <div class="source-node" style="--c: #272B33">
            <span class="node-dot"></span>
            <span class="node-name">Support desk</span>
            <span class="node-sub">tickets</span>
          </div>
          <div class="source-node" style="--c: #2C3340">
            <span class="node-dot"></span>
            <span class="node-name">CRM</span>
            <span class="node-sub">accounts</span>
          </div>
          <div class="source-node" style="--c: #33373D">
            <span class="node-dot"></span>
            <span class="node-name">Spreadsheets</span>
            <span class="node-sub">targets_fy26</span>
          </div>
          <div class="source-node" style="--c: #3B342E">
            <span class="node-dot"></span>
            <span class="node-name">Warehouse</span>
            <span class="node-sub">orders</span>
          </div>
        </div>

        <!-- Floating Live Question Badge -->
        <div class="floating-answer-card">
          <div class="answer-pill-top">
            <span class="ask-label">ASK</span>
            <span class="ask-text">Why did net revenue retention dip in March?</span>
            <span class="status-tag">Answered</span>
          </div>
          <p class="answer-text">
            EU annual renewals slipped three weeks after the invoicing change on 3 March. 11 accounts, all renewed by April.
          </p>
        </div>

        <!-- Status Bottom -->
        <div class="loom-status-bar">
          <span>64 threads</span>
          <span>8 sources</span>
          <span>pick 00192</span>
          <span class="live-status">● active</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 3rem 0 5rem 0;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero-section {
      padding: 4.5rem 0 7rem 0;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 3rem;
    }
  }

  /* Copy styling */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(246, 245, 242, 0.9);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .hero-title {
    font-size: 3rem;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4.25rem;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 4.75rem;
    }
  }

  .hero-title .highlight {
    color: var(--text-primary);
    opacity: 0.5;
  }

  .hero-lede {
    font-size: 1.18rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 540px;
    margin-bottom: 2.25rem;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .hero-metrics-strip {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    max-width: 500px;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .metric-lbl {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
    text-transform: uppercase;
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  /* Loom Container Styling */
  .loom-container {
    position: relative;
    height: 480px;
    background: #dfded9;
    border-radius: 1.5rem;
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 768px) {
    .loom-container {
      height: 540px;
    }
  }

  .loom-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .source-nodes {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 2;
    pointer-events: none;
  }

  .source-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.65rem 0.35rem 0.5rem;
    border-radius: 999px;
    background: rgba(246, 245, 242, 0.9);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 3px rgba(17, 19, 23, 0.08);
    font-size: 0.75rem;
    color: var(--text-primary);
    transform: scale(0.92);
    transform-origin: left center;
  }

  .node-dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background-color: var(--c, #333);
  }

  .node-name {
    font-weight: 500;
  }

  .node-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .floating-answer-card {
    position: absolute;
    right: 1.5rem;
    bottom: 3.5rem;
    max-width: 360px;
    background: rgba(250, 249, 246, 0.95);
    backdrop-filter: blur(12px);
    border-radius: 1.25rem;
    padding: 1rem;
    border: 1px solid rgba(17, 19, 23, 0.08);
    box-shadow: 0 12px 36px -10px rgba(17, 19, 23, 0.22);
    z-index: 3;
  }

  @media (max-width: 480px) {
    .floating-answer-card {
      left: 1rem;
      right: 1rem;
      max-width: none;
    }
    .source-nodes {
      display: none;
    }
  }

  .answer-pill-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }

  .ask-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ask-text {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .status-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
  }

  .answer-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .loom-status-bar {
    position: absolute;
    bottom: 1rem;
    left: 1.5rem;
    right: 1.5rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    z-index: 2;
  }

  .live-status {
    color: var(--accent);
  }
</style>

<script>
  // High-performance canvas thread-weaving simulation
  const canvas = document.getElementById('loomCanvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let animId = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * window.devicePixelRatio;
      canvas.height = height * window.devicePixelRatio;
      if (ctx) ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    };

    window.addEventListener('resize', resize);
    resize();

    // Source origins
    const threadCount = 28;
    const colors = ['#20232A', '#ff4b1f', '#2C3340', '#383830', '#252A36'];
    let offset = 0;

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      offset += 0.015;

      const leftX = 140;
      const rightX = width - 40;

      // Draw subtle grid texture
      ctx.strokeStyle = 'rgba(17, 19, 23, 0.03)';
      ctx.lineWidth = 1;
      for (let x = 0; x < width; x += 16) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }

      // Draw weaving flowing threads
      for (let i = 0; i < threadCount; i++) {
        const startY = (height / threadCount) * i + 20;
        const targetY = height * 0.45 + Math.sin(offset + i * 0.3) * 60;
        const color = colors[i % colors.length];

        ctx.beginPath();
        ctx.strokeStyle = color;
        ctx.lineWidth = i % 5 === 0 ? 2 : 1;
        ctx.globalAlpha = i % 4 === 0 ? 0.75 : 0.25;

        ctx.moveTo(leftX, startY);
        const cp1x = leftX + (rightX - leftX) * 0.4;
        const cp1y = startY + Math.sin(offset + i) * 20;
        const cp2x = leftX + (rightX - leftX) * 0.7;
        const cp2y = targetY + Math.cos(offset + i) * 30;

        ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, rightX, targetY + (i - threadCount / 2) * 4);
        ctx.stroke();

        // Highlight bead moving on thread
        const progress = (offset * 0.5 + i * 0.1) % 1;
        const t = progress;
        const beadX = Math.pow(1 - t, 3) * leftX + 3 * Math.pow(1 - t, 2) * t * cp1x + 3 * (1 - t) * Math.pow(t, 2) * cp2x + Math.pow(t, 3) * rightX;
        const beadY = Math.pow(1 - t, 3) * startY + 3 * Math.pow(1 - t, 2) * t * cp1y + 3 * (1 - t) * Math.pow(t, 2) * cp2y + Math.pow(t, 3) * (targetY + (i - threadCount / 2) * 4);

        ctx.fillStyle = i % 3 === 0 ? '#ff4b1f' : '#111317';
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.arc(beadX, beadY, i % 3 === 0 ? 2.5 : 1.8, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1.0;
      animId = requestAnimationFrame(draw);
    };

    draw();

    // Clean up if destroyed
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('resize', resize);
    });
  }
</script>
