---
// PlainEnglishSection Component: Interactive questions & live answer swatches
const questionItems = [
  {
    id: "q1",
    question: "Which regions grew fastest last quarter?",
    figure: "+38%",
    caption: "Nordics led at +38%, driven by 41 new mid-market accounts; Iberia and Benelux followed.",
    image: "/images/lOC8ZwjsjYPCsj07AnYEf5pIKdo.jpg",
    alt: "Woven answer: +38% with bars by region"
  },
  {
    id: "q2",
    question: "How long do P1 tickets stay open?",
    figure: "4.2H",
    caption: "Median P1 time-to-close fell from 7.1 to 4.2 hours after the on-call rota changed in May.",
    image: "/images/4ApryfqiM3YP0tgrDMwvfdBbtc.jpg",
    alt: "Woven answer: 4.2 hours with a falling curve"
  },
  {
    id: "q3",
    question: "What is our net revenue retention?",
    figure: "112%",
    caption: "112% trailing twelve months. Expansion from seat growth outweighs churn two to one.",
    image: "/images/4Qn9b2uDIMi9Q4E9XtBtjw2SJrw.jpg",
    alt: "Woven answer: 112% with a rising curve"
  },
  {
    id: "q4",
    question: "Which campaigns paid back inside 90 days?",
    figure: "6/14",
    caption: "Six of fourteen campaigns paid back inside 90 days; all six targeted existing customers.",
    image: "/images/r9zYCWH00VLlf09ffmhM8gMlcA.jpg",
    alt: "Woven answer: 6 of 14 with a stepped chart"
  }
];
---

<section class="section-wrapper plain-english-section" id="ask">
  <div class="container">
    <div class="pe-header">
      <span class="section-tag">05 · Ask</span>
      <h2 class="section-heading">Type the question you would ask your analyst.</h2>
      <p class="section-lede">
        No SQL, no dashboard to find. Pick a question below to see the answer Warpyn weaves, with the figure first and the reason underneath.
      </p>
    </div>

    <!-- Interactive Tabs Grid -->
    <div class="ask-grid">
      <!-- Questions List (Left) -->
      <div class="questions-list">
        {questionItems.map((item, idx) => (
          <button
            class={`question-btn ${idx === 0 ? "active" : ""}`}
            data-target={item.id}
            aria-selected={idx === 0 ? "true" : "false"}
          >
            <div class="q-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <span class="q-text">{item.question}</span>
            <span class="q-figure-peek">{item.figure}</span>
          </button>
        ))}
      </div>

      <!-- Active Answer Swatch Display (Right) -->
      <div class="answer-display-wrapper">
        {questionItems.map((item, idx) => (
          <div
            class={`answer-swatch-card ${idx === 0 ? "active" : ""}`}
            id={`panel-${item.id}`}
          >
            <div class="swatch-header">
              <div class="swatch-figure">{item.figure}</div>
              <p class="swatch-caption">{item.caption}</p>
            </div>

            <div class="swatch-image-container">
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                class="swatch-img"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pe-header {
    margin-bottom: 3.5rem;
  }

  .ask-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .ask-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: 3rem;
    }
  }

  /* Question Selector Buttons */
  .questions-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .question-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    text-align: left;
    padding: 1.15rem 1.35rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    transition: all 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .question-btn:hover {
    background: #fff;
    border-color: var(--border-strong);
    transform: translateX(4px);
  }

  .question-btn.active {
    background: #fff;
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(255, 75, 31, 0.12);
  }

  .q-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--bg-tag);
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .question-btn.active .q-icon {
    background: var(--accent-light);
    color: var(--accent);
  }

  .q-text {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .q-figure-peek {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--bg-tag);
  }

  /* Answer Swatch Cards */
  .answer-display-wrapper {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
  }

  .answer-swatch-card {
    display: none;
    flex-direction: column;
    animation: fadeIn 0.25s ease forwards;
  }

  .answer-swatch-card.active {
    display: flex;
  }

  .swatch-header {
    margin-bottom: 1.75rem;
  }

  .swatch-figure {
    font-family: var(--font-display);
    font-size: 3.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 0.65rem;
  }

  .swatch-caption {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .swatch-image-container {
    border-radius: 1rem;
    overflow: hidden;
    background: #e3e0db;
    border: 1px solid var(--border);
  }

  .swatch-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const btns = document.querySelectorAll('.question-btn');
  const panels = document.querySelectorAll('.answer-swatch-card');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');

      // Update button state
      btns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // Update panel visibility
      panels.forEach((p) => p.classList.remove('active'));
      const activePanel = document.getElementById(`panel-${target}`);
      if (activePanel) {
        activePanel.classList.add('active');
      }
    });
  });
</script>
