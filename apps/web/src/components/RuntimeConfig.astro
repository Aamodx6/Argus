---
import { publicOrigin } from '../lib/routes.mjs';
const apiBaseUrl = publicOrigin(import.meta.env.PUBLIC_API_URL);
const guarded = import.meta.env.PUBLIC_REQUIRE_MODERATION !== '0';
---
<script is:inline define:vars={{ apiBaseUrl, guarded }}>
  window.nuanceConfig = { apiBaseUrl, guarded };
  window.nuanceApiUrl = (path) => apiBaseUrl + path;
</script>
