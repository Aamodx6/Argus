---
// Footer Component: Modern SaaS dark footer with live status indicator
---

<footer class="footer-wrapper">
  <div class="container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand & Tagline -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand">
          <span class="f-mark">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="3" width="7" height="3" rx="1.5" fill="#fff" />
              <rect x="11" y="3" width="7" height="3" rx="1.5" fill="#ff4b1f" />
              <rect x="2" y="8.5" width="10" height="3" rx="1.5" fill="#fff" />
              <rect x="14" y="8.5" width="4" height="3" rx="1.5" fill="#fff" />
              <rect x="2" y="14" width="4" height="3" rx="1.5" fill="#ff4b1f" />
              <rect x="8" y="14" width="10" height="3" rx="1.5" fill="#fff" />
            </svg>
          </span>
          <span class="f-name">Warpyn</span>
        </a>
        <p class="f-desc">
          Ask your data in plain English. Every figure is woven from rows you can trace.
        </p>

        <div class="live-status-pill">
          <span class="status-pulse"></span>
          <span>All threads running · 99.98% uptime</span>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="footer-links-grid">
        <div class="link-col">
          <h4 class="col-title">Product</h4>
          <ul class="col-links">
            <li><a href="/product">Product overview</a></li>
            <li><a href="/#lineage">Lineage</a></li>
            <li><a href="/#pulse">Pulse alerts</a></li>
            <li><a href="/#security">Security</a></li>
            <li><a href="/pricing">Pricing</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">Sources</h4>
          <ul class="col-links">
            <li><a href="/#sources">Ledgerline (Billing)</a></li>
            <li><a href="/#sources">Pipewell (CRM)</a></li>
            <li><a href="/#sources">Quarry (Warehouse)</a></li>
            <li><a href="/#sources">Northdesk (Support)</a></li>
            <li><a href="/#sources">All 240+ sources</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">Company</h4>
          <ul class="col-links">
            <li><a href="/#stories">Customers</a></li>
            <li><a href="#">About us</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="mailto:hello@warpyn.example">Security review</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">Legal</h4>
          <ul class="col-links">
            <li><a href="#">Terms of service</a></li>
            <li><a href="#">Privacy policy</a></li>
            <li><a href="#">Data processing (DPA)</a></li>
            <li><a href="mailto:hello@warpyn.example">Contact security</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Giant subtle typographic wordmark -->
    <div class="giant-wordmark">
      Warpyn
    </div>

    <!-- Fine Print Bottom -->
    <div class="footer-bottom">
      <p class="copyright">
        © 2026 Warpyn Labs. Answers woven in Lisbon and New York.
      </p>
      <div class="bottom-tags">
        <span>SOC2 Type II</span>
        <span>•</span>
        <span>Read-only credentials</span>
        <span>•</span>
        <span>Zero-copy analytics</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--bg-dark);
    color: var(--text-inverted);
    padding: 5rem 0 2.5rem 0;
    margin-top: 4rem;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border-dark);
  }

  @media (min-width: 992px) {
    .footer-top-grid {
      grid-template-columns: 1.15fr 2fr;
      gap: 4rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-inverted);
    margin-bottom: 1rem;
  }

  .f-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
  }

  .f-desc {
    color: var(--text-inverted-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 320px;
    margin-bottom: 1.75rem;
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-inverted-muted);
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  /* Links grid */
  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .footer-links-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-inverted);
    margin-bottom: 1.25rem;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-links a {
    color: var(--text-inverted-muted);
    font-size: 0.88rem;
    transition: color 0.18s ease;
  }

  .col-links a:hover {
    color: var(--text-inverted);
  }

  /* Giant wordmark */
  .giant-wordmark {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 11rem);
    font-weight: 700;
    color: rgba(244, 243, 239, 0.04);
    letter-spacing: -0.04em;
    text-align: center;
    line-height: 1;
    padding: 2.5rem 0 1.5rem 0;
    user-select: none;
  }

  /* Bottom fine print */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
    font-size: 0.82rem;
    color: var(--text-inverted-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .bottom-tags {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.75;
  }
</style>
