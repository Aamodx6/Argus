---
import RuntimeConfig from './RuntimeConfig.astro';
interface Props { mode: 'login' | 'signup' }
const { mode } = Astro.props;
const signup = mode === 'signup';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{signup ? 'Create account' : 'Sign in'} · Nuance</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" />
    <RuntimeConfig />
    <script src="/nuance-navigation.js" is:inline></script>
    <script src="/auth-form.js" defer is:inline></script>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a href="/" class="brand" aria-label="Nuance home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>Nuance</a>
        <div class="nav-links"><a href="/product">Product</a><a href="/sources">Sources</a><a href="/customers">Customers</a><a href="/pricing">Pricing</a><a href="/changelog">Changelog</a></div>
        <div class="header-actions"><a href="/login" class="pill secondary">Sign in</a><a href="/contact" class="pill primary">Connect a source</a></div>
      </nav>
    </header>
    <main>
      <section class="intro" aria-labelledby="auth-heading">
        <div><p class="eyebrow"><span></span>{signup ? 'New workspace' : 'Account access'}</p><h1 id="auth-heading">{signup ? 'Deploy your video sentiment workspace.' : 'Sign in to your workspace.'}</h1></div>
        <p class="intro-copy">{signup ? 'Create an account for your video aspect sentiment workspace, API access, and analysis history.' : 'Enter your credentials to access your video aspect sentiment workspace and API usage.'}</p>
      </section>
      <div class="auth-grid">
        <form data-auth-mode={mode} method="post">
          <noscript>JavaScript is required to sign in or create a workspace.</noscript>
          {signup && <label>Username<input name="name" autocomplete="name" placeholder="Your name" minlength="3" required /></label>}
          <label>Email address<input name="email" type="email" autocomplete="email" placeholder="you@company.com" required /></label>
          <label>Password<input name="password" type="password" placeholder="Enter your password" minlength={signup ? 8 : undefined} autocomplete={signup ? 'new-password' : 'current-password'} required /></label>
          {signup && <label>Confirm password<input name="confirmPassword" type="password" placeholder="Repeat your password" minlength="8" autocomplete="new-password" required /></label>}
          <p class="form-status" role="status" aria-live="polite" data-auth-status></p>
          <button class="submit" type="submit">{signup ? 'Deploy workspace' : 'Sign in to workspace'} <span aria-hidden="true">→</span></button>
          <a class="alternate" href={signup ? '/login' : '/signup'}>{signup ? 'Sign in to existing workspace' : 'Deploy a new workspace'} <span aria-hidden="true">→</span></a>
          <p class="form-note">{signup ? 'Your workspace starts with your account' : 'Your credentials stay private'}</p>
        </form>
        <aside aria-label="Workspace information">
          <section class="info-card dark"><p class="eyebrow">Workspace</p><h2>Video, voice, and meaning.</h2><p>One place for your video insights.</p></section>
          <section class="info-card"><p class="eyebrow">API access</p><h2>Your own API key.</h2><p>Manage requests and view your usage.</p></section>
          <section class="info-card"><p class="eyebrow">Security</p><h2>Access stays with your team.</h2><p>Sign in before viewing private workspace data.</p></section>
          <section class="info-card"><p class="eyebrow">Get started</p><h2><a href={signup ? '/login' : '/signup'}>{signup ? 'Already have an account?' : 'New to Nuance?'} <span aria-hidden="true">→</span></a></h2><p>{signup ? 'Return to your existing workspace.' : 'Create your workspace in a few steps.'}</p></section>
        </aside>
      </div>
    </main>
  </body>
</html>
<style>
  @font-face{font-family:'Funnel Display';src:url('/fonts.gstatic.com/s/funneldisplay/v3/B50bF7FGv37QNVWgE0ga--4PbZSRJXrOHcLHLoAYqGPXXcVwIZDKFA.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap}
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#e6e5e1;color:#111317;font:15px Arial,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit} .site-header{border-bottom:1px solid rgba(17,19,23,.08)} nav{min-height:68px;max-width:1600px;margin:auto;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:20px;font-weight:600;letter-spacing:-.04em}.brand-mark{display:flex;gap:3px}.brand-mark i{height:17px;width:3px;background:#111317}.brand-mark i:nth-child(2){background:#ff4b1f}
  .nav-links,.header-actions{display:flex;align-items:center;gap:24px}.nav-links a{text-decoration:none;font-size:13px}.nav-links a:hover{color:#d64117}.header-actions{gap:8px}.pill{padding:10px 16px;border-radius:999px;text-decoration:none;font-size:13px;white-space:nowrap}.secondary{border:1px solid #cbc9c4}.primary{background:#111317;color:#fff}
  main{max-width:1360px;margin:86px auto 96px;padding:0 32px}.intro{display:grid;grid-template-columns:1.8fr 1fr;align-items:end;gap:60px}.eyebrow{display:flex;align-items:center;gap:10px;font:10px/1.5 monospace;letter-spacing:.12em;text-transform:uppercase;color:#63666c}.eyebrow>span{width:7px;height:7px;background:#ff4b1f;border-radius:1px}h1{max-width:840px;margin:24px 0 0;font:500 clamp(40px,5vw,76px)/1.03 'Funnel Display',Arial,sans-serif;letter-spacing:-.05em}.intro-copy{max-width:390px;line-height:1.6;color:#62646a;margin:0 0 6px}
  :global(body.nuance-transition-ready) main{animation:auth-page-enter .55s cubic-bezier(.65,0,.35,1) backwards}
  @keyframes auth-page-enter{from{opacity:0;transform:translate3d(20px,8px,0)}to{opacity:1;transform:translate3d(0,0,0)}}
  @media(prefers-reduced-motion:reduce){:global(body.nuance-transition-ready) main{animation:none}}
  .auth-grid{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(280px,1fr);align-items:start;gap:52px;margin-top:68px}form{min-width:0;padding:38px;background:#f4f3ef;border:1px solid rgba(17,19,23,.1);border-radius:28px;display:grid;gap:26px}label{display:grid;gap:12px;font:10px/1.5 monospace;letter-spacing:.1em;text-transform:uppercase;color:#6c6e73}input{width:100%;height:48px;background:#e6e5e1;color:#111317;border:1px solid #d1cfca;border-radius:14px;padding:0 16px;font:14px Arial,sans-serif;letter-spacing:0;text-transform:none}input:focus{outline:2px solid #a84625;outline-offset:2px}
  .submit,.alternate{display:flex;align-items:center;justify-content:center;gap:16px;min-height:46px;border-radius:999px;font:14px Arial,sans-serif}.submit{justify-self:start;min-width:220px;border:0;background:#111317;color:white;padding:0 24px;cursor:pointer}.submit span,.alternate span,.info-card h2 span{color:#de5428}.submit:disabled{opacity:.65;cursor:wait}.alternate{border:1px solid #d9d7d2;background:#fff;text-decoration:none;padding:10px 20px}.form-note{text-align:center;font:10px/1.5 monospace;text-transform:uppercase;letter-spacing:.06em;color:#8c8e93;margin:-10px 0 0}.form-status{margin:0;color:#b42318;font-size:13px;line-height:1.5}.form-status:empty{display:none}.form-status[data-state='success']{color:#13754b}
  aside{display:grid;gap:16px}.info-card{background:#f4f3ef;border:1px solid rgba(17,19,23,.1);border-radius:18px;padding:24px}.info-card .eyebrow{margin:0 0 8px;color:#b64b28}.info-card h2{margin:0;font:500 26px/1.1 'Funnel Display',Arial,sans-serif;letter-spacing:-.03em}.info-card h2 a{text-decoration:none}.info-card>p:last-child{color:#777a80;line-height:1.5;margin:10px 0 0;font-size:13px}.dark{background:#111317;color:#fff}.dark>p:last-child{color:#b1b1b3}
  @media(max-width:760px){nav{padding:16px 20px;gap:12px}.nav-links{display:none}.brand{font-size:18px}.pill{font-size:12px;padding:9px 12px}main{margin-top:44px;padding:0 20px}.intro{grid-template-columns:1fr;gap:24px}h1{font-size:48px}.intro-copy{max-width:100%}.auth-grid{grid-template-columns:1fr;gap:28px;margin-top:36px}form{padding:26px 22px;border-radius:22px;gap:22px}.submit{justify-self:stretch}aside{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.info-card{padding:20px}.info-card h2{font-size:22px}}
  @media(max-width:440px){aside{grid-template-columns:1fr}.header-actions{gap:6px}.primary{padding:9px 10px}.brand{gap:7px}}
  @media(max-width:980px){nav{flex-wrap:wrap}.nav-links{display:flex;order:3;width:100%;justify-content:center;gap:18px}}
  @media(max-width:440px){.nav-links{gap:14px}.nav-links a{font-size:12px}}
  .site-header{position:sticky;top:0;z-index:40;background:rgba(230,229,225,.9);backdrop-filter:blur(16px)}
  nav{max-width:none}
  :global(body){overflow-x:clip}
</style>
