---
// FAQSection Component: Expandable accessible Q&A accordion
const faqs = [
  {
    q: "Does Warpyn copy our data?",
    a: "No. Warpyn reads from your warehouse and tools with read-only credentials and keeps only the query plans and the answers you save. Raw rows stay where they are."
  },
  {
    q: "How does it know what 'revenue' means for us?",
    a: "During setup you confirm about thirty definitions (revenue, active account, churn) in a shared glossary. Every answer shows which definition it used, and changing one re-weaves the answers that depend on it."
  },
  {
    q: "What happens when an answer is wrong?",
    a: "Click any figure to see its thread: the source rows, joins and filters behind it. Flag a step and your data team gets the exact query to fix, not a screenshot."
  },
  {
    q: "Which sources can we connect?",
    a: "240+ connectors, from warehouses and Postgres to billing, CRM, support desks, ad platforms and spreadsheets. Anything with SQL or a REST API can be added in an afternoon."
  },
  {
    q: "Who can see what?",
    a: "Permissions follow your sources. If someone can't see a row in the CRM, the thread from that row never reaches their answer."
  },
  {
    q: "How long does setup take?",
    a: "Most teams ask their first real question on day one. A full rollout with glossary, permissions and alerts takes two to three weeks."
  }
];
---

<section class="section-wrapper faq-section" id="faq">
  <div class="container">
    <div class="faq-grid">
      <!-- Left: Heading & Support contact -->
      <div class="faq-sidebar">
        <span class="section-tag">12 · Questions</span>
        <h2 class="section-heading">What teams ask before they connect anything.</h2>
        <p class="section-lede">
          Something else on your mind? A data engineer answers every message within one working day.
        </p>

        <div class="ask-direct-box">
          <span class="direct-lbl">Need custom connectors or VPC?</span>
          <a href="mailto:hello@warpyn.example" class="btn-secondary">
            Ask us directly →
          </a>
        </div>
      </div>

      <!-- Right: Interactive Accordion -->
      <div class="accordion-list">
        {faqs.map((faq, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.q}</span>
              <span class="faq-toggle-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .faq-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: 4rem;
    }
  }

  .ask-direct-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .direct-lbl {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  /* Accordion styling */
  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item[open] {
    background: #fff;
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-tag);
    color: var(--text-primary);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
    background: var(--accent-light);
    color: var(--accent);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem 1.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
