---
// CustomerStories Component: Case studies & customer quotes
const stories = [
  {
    company: "Brightwater Schools",
    category: "EdTech",
    headline: "Reconciled 14 school databases with tuition billing in one day.",
    metric: "+22%",
    metricLabel: "On-time tuition renewals",
    image: "/images/3DOKUWsbX3voGYdjH208aN2SWY.jpg"
  },
  {
    company: "Kitefin",
    category: "Developer Tools",
    headline: "Attributed cloud computing costs down to individual user tiers.",
    metric: "$180k",
    metricLabel: "Monthly infrastructure saved",
    image: "/images/54phmmb1TKkij7y4YusfCoFXDZ4.jpg"
  },
  {
    company: "Lumbra",
    category: "Fintech",
    headline: "Diagnosed why enterprise EMEA sales stalled during procurement.",
    metric: "−14d",
    metricLabel: "Median deal cycle reduction",
    image: "/images/uCKeE4gnEfCad6uQrmVMnAQ3Rqs.jpg"
  }
];
---

<section class="section-wrapper stories-section" id="stories">
  <div class="container">
    <div class="stories-header">
      <span class="section-tag">08 · Customers</span>
      <h2 class="section-heading">Teams that stopped guessing.</h2>
      <p class="section-lede">
        Companies that replaced conflicting dashboards with plain-English answers their teams actually trust.
      </p>
    </div>

    <!-- Featured Story: Harrow & Pike -->
    <div class="featured-story-card">
      <div class="story-content">
        <div class="story-tag-strip">
          <span class="story-company">Harrow & Pike</span>
          <span class="story-category">Subscription Retail</span>
        </div>

        <blockquote class="story-quote">
          “We thought we had a loyalty problem. Warpyn showed us it was a card-expiry problem, and it took one question to see it.”
        </blockquote>

        <div class="story-author">
          <strong>Maren Solberg</strong>
          <span>Head of Growth, Harrow & Pike</span>
        </div>

        <div class="story-metrics">
          <div class="story-metric">
            <span class="sm-val">−31%</span>
            <span class="sm-lbl">Involuntary churn</span>
          </div>
          <div class="story-metric">
            <span class="sm-val">36%</span>
            <span class="sm-lbl">Traced to expired cards</span>
          </div>
        </div>
      </div>

      <div class="story-visual">
        <img
          src="/images/rUDVif3R8nhzn1Xvyc3KsrIt90.jpg"
          alt="Woven answer swatch for Harrow and Pike: minus 31 percent"
          loading="lazy"
          class="story-img"
        />
      </div>
    </div>

    <!-- Secondary Stories Grid -->
    <div class="stories-grid">
      {stories.map((st) => (
        <div class="sub-story-card">
          <div class="sub-story-img-wrap">
            <img src={st.image} alt={st.company} loading="lazy" class="sub-story-img" />
          </div>
          <div class="sub-story-body">
            <div class="sub-story-meta">
              <span class="sub-company">{st.company}</span>
              <span class="sub-cat">{st.category}</span>
            </div>
            <h3 class="sub-headline">{st.headline}</h3>
            <div class="sub-metric-row">
              <span class="sub-val">{st.metric}</span>
              <span class="sub-lbl">{st.metricLabel}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stories-header {
    margin-bottom: 4rem;
  }

  /* Featured Card */
  .featured-story-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 2rem;
    padding: 2.5rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 992px) {
    .featured-story-card {
      grid-template-columns: 1.2fr 1fr;
      padding: 3.5rem;
      gap: 3.5rem;
    }
  }

  .story-tag-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .story-company {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .story-category {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-tag);
    color: var(--text-muted);
  }

  .story-quote {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .story-quote {
      font-size: 1.85rem;
    }
  }

  .story-author {
    margin-bottom: 2rem;
  }

  .story-author strong {
    display: block;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .story-author span {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .story-metrics {
    display: flex;
    gap: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .sm-val {
    display: block;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .sm-lbl {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .story-visual {
    border-radius: 1.25rem;
    overflow: hidden;
    background: #e0ded9;
  }

  .story-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  /* Sub Stories Grid */
  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .stories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sub-story-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease;
  }

  .sub-story-card:hover {
    transform: translateY(-3px);
  }

  .sub-story-img-wrap {
    height: 180px;
    background: #e2dfda;
    overflow: hidden;
  }

  .sub-story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sub-story-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sub-story-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .sub-company {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sub-cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .sub-headline {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    flex: 1;
  }

  .sub-metric-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .sub-val {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  .sub-lbl {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
