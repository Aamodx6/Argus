---
// PricingSection Component: Tiered plans with interactive billing toggle
const plans = [
  {
    name: "Starter",
    priceMonthly: "$0",
    priceAnnual: "$0",
    period: "forever",
    blurb: "For one team asking its first questions.",
    threads: "3 sources",
    picks: "500 questions / month",
    features: [
      "Plain-English questions",
      "Lineage on every figure",
      "Slack answers",
      "Community support"
    ],
    cta: "Start free",
    href: "#",
    featured: false
  },
  {
    name: "Growth",
    priceMonthly: "$480",
    priceAnnual: "$400",
    period: "/month",
    blurb: "For companies running on their numbers.",
    threads: "25 sources",
    picks: "10,000 questions / month",
    features: [
      "Everything in Starter",
      "Pulse alerts on any metric",
      "Row-level permissions",
      "Scheduled answers to email",
      "Priority support (1 business day)"
    ],
    cta: "Start a 14-day trial",
    href: "#",
    featured: true
  },
  {
    name: "Enterprise",
    priceMonthly: "Custom",
    priceAnnual: "Custom",
    period: "tailored to team",
    blurb: "For regulated data and many teams.",
    threads: "Unlimited sources",
    picks: "Unlimited questions",
    features: [
      "Everything in Growth",
      "SSO, SCIM and audit log",
      "EU or US data residency",
      "Private deployment (VPC)",
      "Named data engineer"
    ],
    cta: "Talk to us",
    href: "#",
    featured: false
  }
];
---

<section class="section-wrapper pricing-section" id="pricing">
  <div class="container">
    <div class="pricing-header">
      <span class="section-tag">11 · Pricing</span>
      <h2 class="section-heading">Priced by sources and questions, not seats.</h2>
      <p class="section-lede">
        Everyone in the company can ask. You pay for how many tools you connect and how many questions you ask each month.
      </p>

      <!-- Billing Toggle Switcher -->
      <div class="billing-switcher-container">
        <span class="billing-label" id="monthlyLabel">Monthly</span>
        <button class="toggle-switch active" id="billingToggle" aria-label="Toggle annual or monthly pricing">
          <span class="toggle-thumb"></span>
        </button>
        <span class="billing-label" id="annualLabel">
          Annual <span class="discount-badge">Save 20%</span>
        </span>
      </div>
    </div>

    <!-- Plans Grid -->
    <div class="pricing-cards-grid">
      {plans.map((p) => (
        <div class={`plan-card ${p.featured ? "featured" : ""}`}>
          {p.featured && <span class="featured-badge">Most Popular</span>}
          
          <div class="card-top">
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-blurb">{p.blurb}</p>
          </div>

          <div class="plan-price-block">
            <div class="price-val" data-monthly={p.priceMonthly} data-annual={p.priceAnnual}>
              {p.priceAnnual}
            </div>
            <div class="price-period">{p.period}</div>
          </div>

          <div class="plan-specs-strip">
            <div class="spec-row">
              <span class="spec-name">Sources:</span>
              <span class="spec-val">{p.threads}</span>
            </div>
            <div class="spec-row">
              <span class="spec-name">Volume:</span>
              <span class="spec-val">{p.picks}</span>
            </div>
          </div>

          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a href={p.href} class={`plan-cta ${p.featured ? "btn-primary" : "btn-secondary"}`}>
            {p.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem auto;
  }

  .pricing-header .section-lede {
    margin: 0 auto 2rem auto;
  }

  /* Billing Switcher */
  .billing-switcher-container {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.35rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .billing-label {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .discount-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    background: var(--accent-light);
    color: var(--accent);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toggle-switch {
    width: 44px;
    height: 24px;
    border-radius: 999px;
    background: #ccc;
    position: relative;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .toggle-switch.active {
    background: var(--accent);
  }

  .toggle-thumb {
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 3px;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .toggle-switch.active .toggle-thumb {
    transform: translateX(20px);
  }

  /* Cards Grid */
  .pricing-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 992px) {
    .pricing-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .plan-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    background: #fff;
  }

  .plan-card.featured {
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 12px 36px -10px rgba(255, 75, 31, 0.16);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--accent);
    color: #fff;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
  }

  .plan-name {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .plan-blurb {
    font-size: 0.92rem;
    color: var(--text-muted);
    min-height: 42px;
  }

  .plan-price-block {
    margin: 1.75rem 0;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .price-val {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }

  .price-period {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .plan-specs-strip {
    background: rgba(17, 19, 23, 0.04);
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.75rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    padding: 0.2rem 0;
  }

  .spec-name {
    color: var(--text-muted);
  }

  .spec-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .plan-features {
    list-style: none;
    margin-bottom: 2.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .check-icon {
    color: var(--accent);
    font-weight: 700;
  }

  .plan-cta {
    width: 100%;
    text-align: center;
  }
</style>

<script>
  const toggle = document.getElementById('billingToggle');
  const priceVals = document.querySelectorAll('.price-val');
  let isAnnual = true;

  if (toggle) {
    toggle.addEventListener('click', () => {
      isAnnual = !isAnnual;
      toggle.classList.toggle('active', isAnnual);

      priceVals.forEach((el) => {
        const monthly = el.getAttribute('data-monthly');
        const annual = el.getAttribute('data-annual');
        el.textContent = isAnnual ? annual : monthly;
      });
    });
  }
</script>
