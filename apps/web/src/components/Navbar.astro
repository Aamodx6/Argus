---
interface Props {
  activePage?: 'home' | 'product' | 'pricing' | 'none';
}

const { activePage = 'home' } = Astro.props;
---

<header class="navbar-wrapper">
  <div class="container">
    <nav class="navbar" aria-label="Main Navigation">
      <!-- Brand Logo -->
      <a href="/" class="brand" aria-label="Warpyn Home">
        <span class="brand-mark">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="3" width="7" height="3" rx="1.5" fill="#111317" />
            <rect x="11" y="3" width="7" height="3" rx="1.5" fill="#ff4b1f" />
            <rect x="2" y="8.5" width="10" height="3" rx="1.5" fill="#111317" />
            <rect x="14" y="8.5" width="4" height="3" rx="1.5" fill="#111317" />
            <rect x="2" y="14" width="4" height="3" rx="1.5" fill="#ff4b1f" />
            <rect x="8" y="14" width="10" height="3" rx="1.5" fill="#111317" />
          </svg>
        </span>
        <span class="brand-name">Warpyn</span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="nav-links">
        <a href="/product" class={`nav-link ${activePage === 'product' ? 'active' : ''}`}>Product</a>
        <a href="/pricing" class={`nav-link ${activePage === 'pricing' ? 'active' : ''}`}>Pricing</a>
        <a href="/#security" class="nav-link">Security</a>
        <a href="/#faq" class="nav-link">FAQ</a>
      </div>

      <!-- Action Buttons -->
      <div class="nav-actions">
        <a href="/#pricing" class="btn-text">Sign in</a>
        <a href="/#pricing" class="btn-primary-sm">Start weaving</a>
      </div>

      <!-- Mobile Menu Button -->
      <button class="mobile-toggle" aria-label="Toggle Navigation Menu" id="mobileMenuBtn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>

    <!-- Mobile Drawer -->
    <div class="mobile-drawer" id="mobileDrawer">
      <div class="mobile-links">
        <a href="/product" class="mobile-link">Product</a>
        <a href="/pricing" class="mobile-link">Pricing</a>
        <a href="/#security" class="mobile-link">Security</a>
        <a href="/#faq" class="mobile-link">FAQ</a>
        <hr class="mobile-divider" />
        <a href="/#pricing" class="btn-primary mobile-cta">Start weaving</a>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(230, 229, 225, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(17, 19, 23, 0.06);
    transition: all 0.25s ease;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(246, 245, 242, 0.9);
    border: 1px solid var(--border);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .nav-actions {
      display: flex;
    }
  }

  .btn-text {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .btn-text:hover {
    color: var(--text-primary);
  }

  .btn-primary-sm {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    background-color: var(--text-primary);
    color: var(--text-inverted);
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-primary-sm:hover {
    background-color: #000;
    transform: translateY(-1px);
  }

  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--text-primary);
    border-radius: 8px;
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-drawer {
    display: none;
    padding: 1.5rem 0 1rem 0;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--bg-card);
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .mobile-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 0.25rem 0;
  }

  .mobile-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0.5rem 0;
  }

  .mobile-cta {
    width: 100%;
    text-align: center;
  }
</style>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('open');
    });
  }
</script>
