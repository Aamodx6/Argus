---
import Analytics from '@vercel/analytics/astro';
import PricingCheckout from './PricingCheckout.astro';
import shell from '../templates/marketing-shell.html?raw';
import { normalizeTemplateHtml } from '../lib/routes.mjs';
interface Props { title: string }
const { title } = Astro.props;
const html = normalizeTemplateHtml(shell)
  .replace(/<title>[^<]*<\/title>/, `<title>${title} · Argus</title>`)
  .replace('</head>', '<link rel="stylesheet" href="/nuance-transitions.css"><script src="/nuance-navigation.js"></script></head>');
const headMatch = html.match(/<head>([\s\S]*?)<\/head>/i);
const bodyMatch = html.match(/<body>([\s\S]*?)<\/body>/i);
const headHtml = headMatch ? headMatch[1] : '';
const bodyHtml = bodyMatch ? bodyMatch[1] : '';
---
<!doctype html>
<html data-valorsic-studio="true" data-framer-marketing="" data-account-state="checking">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body>
    <Fragment set:html={bodyHtml} />
    <PricingCheckout />
    <script type="module" src="/account-header.mjs" is:inline></script>
    <Analytics />
  </body>
</html>
