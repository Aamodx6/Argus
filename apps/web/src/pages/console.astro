---
import Analytics from "@vercel/analytics/astro";
import RuntimeConfig from '../components/RuntimeConfig.astro';
import ArgusPipeline from '../components/ArgusPipeline.astro';
---
<!doctype html>
<html lang="en" data-motion={import.meta.env.PUBLIC_MOTION === "full" ? "full" : "auto"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Console · Argus</title>
    <link rel="icon" href="/favicon.png" />
    <RuntimeConfig />
    <link rel="stylesheet" href="/nuance-transitions.css" />
    <script src="/nuance-navigation.js" is:inline></script>
    <link rel="stylesheet" href="/argus-pipeline.css" />
    <link rel="stylesheet" href="/console-workspace.css" />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <ArgusPipeline />
    <script type="module" src="/console-workspace.mjs" is:inline></script>
    <Analytics />
  </body>
</html>
