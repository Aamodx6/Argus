---
import RuntimeConfig from "../components/RuntimeConfig.astro";
// Nuance Multimodal Video Sentiment Console - Bento Design Workspace
---
<!doctype html>
<html lang="en">
<head>
  <RuntimeConfig />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nuance · Multimodal Sentiment Console</title>
  <meta name="description" content="Multimodal video sentiment and emotion analysis pipeline powered by AWS SageMaker." />
  <link rel="icon" href="/framerusercontent.com/images/w6xhB1HNHWbIWHXZPYWLdAm0i0c.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400;500;600;700&family=Funnel+Sans:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/nuance-transitions.css" />
  <script src="/nuance-navigation.js" is:inline></script>

  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-cream: #fbfbf9;
      --card-bg: #ffffff;
      --card-subtle: #f5f4ef;
      --card-border: #e6e4dc;
      --card-border-subtle: rgba(17, 19, 23, 0.07);
      --text-primary: #111317;
      --text-secondary: #4b505a;
      --text-muted: #838896;
      --accent-orange: #ff4b1f;
      --accent-orange-hover: #e03f16;
      --accent-green: #10b981;
      --code-bg: #111317;
      --code-border: #23272e;
    }

    body {
      background-color: var(--bg-cream);
      color: var(--text-primary);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Workspace Header (No marketing links, pure console bar) */
    .workspace-header {
      width: 100%;
      border-bottom: 1px solid var(--card-border-subtle);
      background: rgba(251, 251, 249, 0.95);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .workspace-header-inner {
      max-width: 1360px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-primary);
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      height: 20px;
    }

    .brand-bar {
      width: 3.5px;
      height: 15px;
      background: var(--text-primary);
      border-radius: 2px;
    }
    .brand-bar.accent {
      background: var(--accent-orange);
      height: 19px;
    }

    .brand-name {
      font-family: 'Funnel Display', sans-serif;
      font-weight: 600;
      font-size: 18px;
      letter-spacing: -0.02em;
    }

    .header-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: 4px;
    }

    .breadcrumb-sep {
      color: var(--card-border);
      font-weight: 400;
    }

    .breadcrumb-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
    }

    .header-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: #eff6f3;
      border: 1px solid #d1fae5;
      border-radius: 9999px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      color: #065f46;
      margin-left: 8px;
    }

    .status-dot-pulse {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 6px #10b981;
    }

    .header-user-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      color: var(--text-secondary);
      background: #eae8e1;
      padding: 6px 12px;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .user-chip .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
    }

    .btn-signout {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-primary);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .btn-signout:hover {
      background: rgba(255, 75, 31, 0.08);
      border-color: var(--accent-orange);
      color: var(--accent-orange);
    }

    /* Console Page Canvas */
    .console-canvas {
      max-width: 1360px;
      width: 100%;
      margin: 0 auto;
      padding: 28px 24px 60px 24px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    /* Subhead / Context Bar */
    .console-context {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      padding-bottom: 6px;
    }

    .context-left {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .context-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-orange);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .context-title {
      font-family: 'Funnel Display', sans-serif;
      font-size: 28px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .context-desc {
      font-size: 13.5px;
      color: var(--text-secondary);
      max-width: 720px;
      line-height: 1.45;
    }

    .context-meta-pills {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .meta-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--text-secondary);
      background: #ffffff;
      border: 1px solid var(--card-border);
      padding: 5px 11px;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    /* Bento Grid Master Layout */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 16px;
    }

    /* Bento Card Base */
    .bento-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 1px 3px rgba(17, 19, 23, 0.02);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .bento-card:hover {
      border-color: #d8d5cb;
      box-shadow: 0 4px 14px rgba(17, 19, 23, 0.035);
    }

    .bento-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .bento-header-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .bento-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-muted);
    }

    .bento-title {
      font-family: 'Funnel Display', sans-serif;
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.015em;
    }

    .bento-desc {
      font-size: 12.5px;
      color: var(--text-secondary);
      line-height: 1.45;
    }

    .bento-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
      background: #eae8e1;
      color: var(--text-secondary);
      white-space: nowrap;
    }

    .bento-tag.live {
      background: #eff6f3;
      color: #065f46;
      border: 1px solid #d1fae5;
    }

    /* CELL 1: Video Upload & Ingest (Cols 1-7) */
    .bento-cell-upload {
      grid-column: span 12;
    }
    @media (min-width: 1024px) {
      .bento-cell-upload {
        grid-column: span 7;
      }
    }

    .dropzone-inner {
      background: #faf9f6;
      border: 2px dashed #d6d3c8;
      border-radius: 16px;
      padding: 32px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      flex: 1;
      min-height: 220px;
    }

    .dropzone-inner:hover, .dropzone-inner.dragover {
      border-color: var(--text-primary);
      background: #f4f3ed;
    }

    .dropzone-icon-ring {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #eae8e1;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
      color: var(--text-primary);
      transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .dropzone-inner:hover .dropzone-icon-ring {
      transform: translateY(-2px);
      background: #dfdcd3;
    }

    .dropzone-prompt {
      font-family: 'Funnel Display', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .dropzone-sub {
      font-size: 12.5px;
      color: var(--text-secondary);
      max-width: 380px;
      line-height: 1.4;
      margin-bottom: 16px;
    }

    .dropzone-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-dark-pill {
      background: var(--text-primary);
      color: #ffffff;
      border: none;
      border-radius: 9999px;
      padding: 8px 18px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.15s ease;
    }
    .btn-dark-pill:hover {
      background: #252830;
    }

    .btn-light-pill {
      background: #ffffff;
      color: var(--text-primary);
      border: 1px solid var(--card-border);
      border-radius: 9999px;
      padding: 8px 18px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }
    .btn-light-pill:hover {
      background: #f4f3ef;
      border-color: #cfccc2;
    }

    .format-chips {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 14px;
    }

    .format-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--text-muted);
      background: rgba(17, 19, 23, 0.04);
      padding: 2px 7px;
      border-radius: 4px;
    }

    /* Live Processing Progress inside Card */
    .processing-bar-wrap {
      width: 100%;
      max-width: 440px;
      margin-top: 14px;
      display: none;
      flex-direction: column;
      gap: 6px;
    }

    .processing-status-text {
      font-size: 12px;
      font-weight: 500;
      color: var(--accent-orange);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .progress-track {
      height: 6px;
      width: 100%;
      background: #eae8e1;
      border-radius: 9999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 30%;
      background: var(--accent-orange);
      border-radius: 9999px;
      transition: width 0.3s ease;
    }

    /* Alerts */
    .console-alert {
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 12.5px;
      display: none;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }
    .console-alert.error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }
    .console-alert.warning {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    /* CELL 2: Multimodal Emotion & Sentiment (Cols 8-12) */
    .bento-cell-metrics {
      grid-column: span 12;
    }
    @media (min-width: 1024px) {
      .bento-cell-metrics {
        grid-column: span 5;
      }
    }

    .metrics-standby {
      flex: 1;
      background: #faf9f6;
      border: 1px dashed #d6d3c8;
      border-radius: 16px;
      padding: 28px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--text-muted);
      gap: 10px;
      min-height: 220px;
    }

    .standby-glyphs {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 26px;
      opacity: 0.5;
    }

    .standby-title {
      font-family: 'Funnel Display', sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .standby-desc {
      font-size: 12px;
      max-width: 260px;
      line-height: 1.4;
    }

    .metrics-active-panel {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 100%;
      justify-content: space-between;
    }

    .dual-metric-boxes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .metric-gauge-box {
      background: var(--card-subtle);
      border-radius: 14px;
      padding: 18px 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 4px;
      border: 1px solid rgba(17, 19, 23, 0.04);
    }

    .gauge-label {
      font-size: 10.5px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .gauge-emoji {
      font-size: 40px;
      line-height: 1.1;
      margin: 4px 0;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.06));
    }

    .gauge-name {
      font-family: 'Funnel Display', sans-serif;
      font-size: 17px;
      font-weight: 600;
      color: var(--text-primary);
      text-transform: capitalize;
    }

    .gauge-conf {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      color: var(--text-secondary);
    }

    .metrics-summary-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--card-subtle);
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 11px;
      color: var(--text-secondary);
      font-family: 'JetBrains Mono', monospace;
    }

    /* CELL 3: Secret Key & Credentials (Cols 1-4) */
    .bento-cell-key {
      grid-column: span 12;
    }
    @media (min-width: 768px) {
      .bento-cell-key {
        grid-column: span 6;
      }
    }
    @media (min-width: 1024px) {
      .bento-cell-key {
        grid-column: span 4;
      }
    }

    .key-surface {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: auto;
    }

    .key-display-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .key-code-pill {
      flex: 1;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      background: var(--card-subtle);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 8px 12px;
      color: var(--text-primary);
      overflow-x: auto;
      white-space: nowrap;
    }

    .btn-key-copy {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 8px 14px;
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-primary);
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .btn-key-copy:hover {
      background: #f4f3ef;
      border-color: #cfccc2;
    }

    .key-security-note {
      font-size: 11.5px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* CELL 4: Monthly Quota & Usage (Cols 5-7) */
    .bento-cell-quota {
      grid-column: span 12;
    }
    @media (min-width: 768px) {
      .bento-cell-quota {
        grid-column: span 6;
      }
    }
    @media (min-width: 1024px) {
      .bento-cell-quota {
        grid-column: span 3;
      }
    }

    .quota-surface {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: auto;
    }

    .quota-stat-large {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .quota-number-big {
      font-family: 'Funnel Display', sans-serif;
      font-size: 32px;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1;
    }

    .quota-total-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      color: var(--text-muted);
    }

    .quota-track-wrap {
      height: 6px;
      width: 100%;
      background: #eae8e1;
      border-radius: 9999px;
      overflow: hidden;
    }

    .quota-fill-bar {
      height: 100%;
      background: var(--text-primary);
      border-radius: 9999px;
      transition: width 0.3s ease;
    }

    .quota-sub-info {
      font-size: 11.5px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* CELL 5: Developer SDK Tabs & Code (Cols 8-12) */
    .bento-cell-sdk {
      grid-column: span 12;
    }
    @media (min-width: 1024px) {
      .bento-cell-sdk {
        grid-column: span 5;
      }
    }

    .code-console-wrapper {
      background: var(--code-bg);
      border: 1px solid var(--code-border);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin-top: 4px;
    }

    .code-tab-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #181b21;
      border-bottom: 1px solid var(--code-border);
      padding: 0 4px;
    }

    .code-tab-group {
      display: flex;
      align-items: center;
    }

    .code-tab-btn {
      padding: 8px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: #9499a8;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .code-tab-btn:hover {
      color: #ffffff;
    }
    .code-tab-btn.active {
      color: #ffffff;
      font-weight: 600;
      border-bottom: 2px solid var(--accent-orange);
      background: rgba(255, 255, 255, 0.04);
    }

    .btn-code-copy {
      background: transparent;
      border: none;
      color: #9ca3af;
      font-size: 11px;
      font-family: 'JetBrains Mono', monospace;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 8px;
      border-radius: 4px;
      transition: all 0.15s ease;
    }
    .btn-code-copy:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
    }

    .code-pre-block {
      padding: 14px 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      color: #d1d5db;
      line-height: 1.55;
      max-height: 200px;
      overflow-y: auto;
      white-space: pre;
    }

    /* CELL 6: Spoken Segments Multimodal Timeline (Cols 1-12) */
    .bento-cell-timeline {
      grid-column: span 12;
    }

    .timeline-standby {
      background: #faf9f6;
      border: 1px dashed #d6d3c8;
      border-radius: 16px;
      padding: 36px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--text-muted);
      gap: 8px;
    }

    .utterances-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .utterance-item {
      background: #faf9f6;
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 18px 20px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      transition: border-color 0.15s ease;
    }

    @media (min-width: 768px) {
      .utterance-item {
        grid-template-columns: 1.2fr 1fr 1fr;
        align-items: start;
      }
    }

    .utterance-item:hover {
      border-color: #c4c1b5;
    }

    .time-text-col {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .time-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
