    const logoutBtn = document.getElementById("logout-btn");

    const codeBlockContent = document.getElementById("code-block-content");
    const copyCodeBtn = document.getElementById("copy-code-btn");
    const tabBtns = document.querySelectorAll(".code-tab-btn");

    // Init Session & Quota
    async function initSession() {
      // Check stored user/quota
      try {
        const storedUser = localStorage.getItem("nuance_user");
        const storedQuota = localStorage.getItem("nuance_quota");

        if (storedUser) {
          const user = JSON.parse(storedUser);
          if (user.email) userEmailText.textContent = user.email;
        }

        if (storedQuota) {
          const quota = JSON.parse(storedQuota);
          if (quota.secretKey) currentApiKey = quota.secretKey;
          if (typeof quota.requestsUsed === "number") requestsUsed = quota.requestsUsed;
          if (typeof quota.maxRequests === "number") maxRequests = quota.maxRequests;
        }

        if (!currentApiKey) {
          updateUIQuota();
          renderCodeSnippet();
          return;
        }
        const quotaPath = window.nuanceConfig.guarded ? "/api/async-inference/quota" : "/api/quota";
        const res = await fetch(window.nuanceApiUrl(quotaPath), {
          headers: { Authorization: "Bearer " + currentApiKey }, cache: "no-store"
        });
        if (res.ok) {
          const data = await res.json();
          quotaAvailable = true;
          if (window.nuanceConfig.guarded) {
            requestsUsed = data.requests_used;
            maxRequests = data.max_requests;
          } else if (data.quota) {
            currentApiKey = data.quota.secretKey;
            requestsUsed = data.quota.requestsUsed;
            maxRequests = data.quota.maxRequests;
          }
          if (data.user && data.user.email) {
            userEmailText.textContent = data.user.email;
          }
        }
      } catch (err) {
        console.warn("Could not reach /api/quota, using default/local quota:", err);
      }

      updateUIQuota();
      renderCodeSnippet();
    }

    function updateUIQuota() {
      secretKeyDisplay.textContent = currentApiKey || "Sign in to obtain an API key";
      quotaTextDisplay.textContent = quotaAvailable ? `${requestsUsed} / ${maxRequests} requests` : "Usage unavailable";
      if (quotaUsedBig) quotaUsedBig.textContent = requestsUsed;
      const pct = Math.min(100, Math.round((requestsUsed / (maxRequests || 1)) * 100));
      quotaBarFill.style.width = `${pct}%`;
    }

    function renderCodeSnippet() {
      if (window.nuanceConfig.guarded) {
        codeBlockContent.textContent = `Guarded MP4 upload flow:\nPOST ${window.nuanceApiUrl('/api/async-inference/uploads')}\nPOST the signed form and file to S3\nPOST ${window.nuanceApiUrl('/api/async-inference/jobs')} with upload_id\nGET ${window.nuanceApiUrl('/api/async-inference/jobs/{job_id}')} until terminal status\n\nAuthenticate API requests with Authorization: Bearer YOUR_API_KEY.\nS3 receives only the signed form and file.`;
        return;
      }
      if (currentTab === "ts") {
        codeBlockContent.textContent = tsCode.replace('apiKey', `"${currentApiKey}"`);
      } else if (currentTab === "curl") {
        codeBlockContent.textContent = curlCode.replace('${YOUR_API_KEY}', currentApiKey);
      } else if (currentTab === "python") {
        codeBlockContent.textContent = pythonCode.replace('YOUR_API_KEY', currentApiKey);
      }
    }

    // Code Tab switching
    tabBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        tabBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentTab = btn.getAttribute("data-tab");
        renderCodeSnippet();
      });
    });

    // Copy Secret Key
    copyKeyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(currentApiKey);
        const originalHtml = copyKeyBtn.innerHTML;
        copyKeyBtn.innerHTML = `
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span style="color:#10b981;">Copied!</span>
        `;
        setTimeout(() => {
          copyKeyBtn.innerHTML = originalHtml;
        }, 2000);
      } catch (e) {
        console.error("Failed to copy:", e);
      }
    });

    // Copy Code
    copyCodeBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(codeBlockContent.textContent);
        const originalText = copyCodeBtn.querySelector("span").textContent;
        copyCodeBtn.querySelector("span").textContent = "Copied!";
        setTimeout(() => {
          copyCodeBtn.querySelector("span").textContent = originalText;
        }, 2000);
      } catch (e) {
        console.error("Failed to copy code:", e);
      }
    });

    // Logout
    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("nuance_user");
      localStorage.removeItem("nuance_quota");
      if (window.nuanceNavigate) {
        window.nuanceNavigate("/login");
      } else {
        window.location.href = "/login";
      }
    });

    // Calculate Averages and Render Analysis
    function calculateAverages(analysis) {
      if (!analysis?.analysis?.utterances?.length) return null;

      const emotionScores = {};
      const sentimentScores = {};

      analysis.analysis.utterances.forEach(u => {
        u.emotions.forEach(e => {
          if (!emotionScores[e.label]) emotionScores[e.label] = [];
          emotionScores[e.label].push(e.confidence);
        });
        u.sentiments.forEach(s => {
          if (!sentimentScores[s.label]) sentimentScores[s.label] = [];
          sentimentScores[s.label].push(s.confidence);
        });
      });

      const avgEmotions = Object.entries(emotionScores).map(([label, scores]) => ({
        label,
        confidence: scores.reduce((a, b) => a + b, 0) / scores.length
      })).sort((a, b) => b.confidence - a.confidence);

      const avgSentiments = Object.entries(sentimentScores).map(([label, scores]) => ({
        label,
        confidence: scores.reduce((a, b) => a + b, 0) / scores.length
      })).sort((a, b) => b.confidence - a.confidence);

      return {
        topEmotion: avgEmotions[0],
        topSentiment: avgSentiments[0]
      };
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function renderAnalysis(data) {
      policyAlert.style.display = ['warn', 'throttle', 'suspend'].includes(data.account_policy) ? 'block' : 'none';
      const averages = calculateAverages(data);

      if (averages?.topEmotion && averages?.topSentiment) {
        overallEmpty.style.display = "none";
        overallContent.style.display = "flex";
        if (inferenceStatusTag) {
          inferenceStatusTag.textContent = "Inference Complete";
          inferenceStatusTag.style.background = "#eff6f3";
          inferenceStatusTag.style.color = "#065f46";
        }

        document.getElementById("stat-emotion-emoji").textContent = EMOTION_EMOJI[averages.topEmotion.label] || "😄";
        document.getElementById("stat-emotion-name").textContent = averages.topEmotion.label;
        document.getElementById("stat-emotion-conf").textContent = `${averages.topEmotion.confidence.toFixed(3)} (${Math.round(averages.topEmotion.confidence * 100)}%)`;
        document.getElementById("stat-emotion-bar").style.width = `${Math.round(averages.topEmotion.confidence * 100)}%`;

        document.getElementById("stat-sentiment-emoji").textContent = SENTIMENT_EMOJI[averages.topSentiment.label] || "😄";
        document.getElementById("stat-sentiment-name").textContent = averages.topSentiment.label;
        document.getElementById("stat-sentiment-conf").textContent = `${averages.topSentiment.confidence.toFixed(3)} (${Math.round(averages.topSentiment.confidence * 100)}%)`;
        document.getElementById("stat-sentiment-bar").style.width = `${Math.round(averages.topSentiment.confidence * 100)}%`;
      }

      // Spoken segments
      if (data.analysis?.utterances?.length) {
        segmentsEmpty.style.display = "none";
        segmentsContent.style.display = "flex";
        segmentsContent.innerHTML = "";

        data.analysis.utterances.forEach(u => {
          const item = document.createElement("div");
          item.className = "utterance-item";

          // Emotions HTML
          const emotionsHtml = u.emotions.map(e => `
            <div class="breakdown-row">
              <span class="breakdown-label">
                <span>${EMOTION_EMOJI[e.label] || "•"}</span>
                ${escapeHtml(e.label)}
              </span>
              <div class="breakdown-track">
                <div class="breakdown-fill orange" style="width: ${Math.round(e.confidence * 100)}%;"></div>
              </div>
              <span class="breakdown-percent">${Math.round(e.confidence * 100)}%</span>
            </div>
          `).join("");

          // Sentiments HTML
          const sentimentsHtml = u.sentiments.map(s => `
            <div class="breakdown-row">
              <span class="breakdown-label">
                <span>${SENTIMENT_EMOJI[s.label] || "•"}</span>
                ${escapeHtml(s.label)}
              </span>
              <div class="breakdown-track">
                <div class="breakdown-fill" style="width: ${Math.round(s.confidence * 100)}%;"></div>
              </div>
              <span class="breakdown-percent">${Math.round(s.confidence * 100)}%</span>
            </div>
          `).join("");

          item.innerHTML = `
            <div class="time-text-col">
              <span class="time-badge">${Number(u.start_time).toFixed(1)}s – ${Number(u.end_time).toFixed(1)}s</span>
              <p class="utterance-text">"${escapeHtml(u.text)}"</p>
            </div>
            <div class="breakdown-col">
              <span class="breakdown-title">Emotions</span>
              ${emotionsHtml}
            </div>
            <div class="breakdown-col">
              <span class="breakdown-title">Sentiments</span>
              ${sentimentsHtml}
            </div>
          `;

          segmentsContent.appendChild(item);
        });
      }

      // Increment quota used
      requestsUsed += 1;
      updateUIQuota();
    }

    // Set UI processing state
    function setProcessingState(isProcessing, stepText, pct) {
      if (isProcessing) {
        uploadStatusTitle.textContent = pct > 50 ? "Analysing video..." : "Uploading video...";
        uploadStatusDesc.textContent = stepText || "Streaming frames to multimodal inference pipeline...";
        processingWrap.style.display = "flex";
        processingStatusStep.textContent = stepText || "Processing...";
        processingStatusPct.textContent = `${pct}%`;
        processingFill.style.width = `${pct}%`;
        errorAlert.style.display = "none";
      } else {
        uploadStatusTitle.textContent = "Upload a video";
        uploadStatusDesc.textContent = "Get started with sentiment detection by uploading a video.";
        processingWrap.style.display = "none";
      }
    }

    function showError(msg) {
      errorAlert.textContent = msg;
      errorAlert.style.display = "flex";
      setProcessingState(false);
    }

    // Both upload modes use the actual backend. Failures never become sample predictions.
    async function handleFileUpload(file) {
      if (!file) return;
      try {
        const { analyzeVideo } = await import('/console-api.mjs');
        const result = await analyzeVideo(file, currentApiKey, {
          baseUrl: window.nuanceConfig.apiBaseUrl,
          guarded: window.nuanceConfig.guarded,
          onProgress: (message, percent) => setProcessingState(true, message, percent),
        });
        setProcessingState(false);
        renderAnalysis(result);
        await initSession();
      } catch (error) {
        showError(error.message || "Video analysis is unavailable.");
      }
    }

    // Demo analysis button click
    demoBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setProcessingState(true, "Loading sample data; no video is submitted...", 30);
      setTimeout(() => {
        setProcessingState(true, "Loading saved sample predictions...", 70);
        setTimeout(() => {
          setProcessingState(true, "Aligning spoken segments and confidence...", 100);
          setTimeout(() => {
            setProcessingState(false);
            renderAnalysis(sampleAnalysis);
          }, 300);
        }, 500);
      }, 400);
    });

    // File Input trigger
    chooseFileBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropzone.addEventListener("click", () => {
      fileInput.click();
    });

    fileInput.addEventListener("change", (e) => {
      const file = e.target.files?.[0];
      if (file) handleFileUpload(file);
    });

    // Drag and Drop
    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });

    dropzone.addEventListener("dragleave", () => {
      dropzone.classList.remove("dragover");
    });

    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");
      const file = e.dataTransfer.files?.[0];
      if (file) handleFileUpload(file);
    });

    // Start
    initSession();
  </script>
</body>
</html>
