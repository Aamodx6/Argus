---
<link rel="stylesheet" href="/nuance-transitions.css" />
<script src="/nuance-transitions.js" is:inline></script>
<style is:global>
  button[type="submit"],
  .framer-1rlus6e,
  .framer-14v1qha-container button,
  .framer-vobpJ {
    min-width: 220px !important;
    width: auto !important;
    height: 50px !important;
    padding: 0 28px !important;
    white-space: nowrap !important;
    background-color: rgb(17, 19, 23) !important;
    border-radius: 9999px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    box-sizing: border-box !important;
    transition: background-color 0.15s ease, opacity 0.15s ease !important;
  }
  button[type="submit"]:hover,
  .framer-1rlus6e:hover {
    background-color: rgb(255, 75, 31) !important;
  }
  button[type="submit"] *,
  .framer-1rlus6e * {
    white-space: nowrap !important;
    word-break: keep-all !important;
  }
</style>
<Fragment set:html={rawHtml} />

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    function setupFormHook() {
      const form = document.querySelector('form.framer-z0nr7v') || document.querySelector('form');
      if (!form || form.dataset.hooked) return;
      form.dataset.hooked = 'true';

      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.framer-14v1qha-container');
      const submitSpan = submitBtn ? (submitBtn.querySelector('span:first-child') || submitBtn) : null;
      const originalBtnText = 'Deploy workspace';

      // Inline micro-status text below button without shifting layout
      let statusText = document.getElementById('form-inline-status');
      if (!statusText) {
        statusText = document.createElement('div');
        statusText.id = 'form-inline-status';
        statusText.style.cssText = 'font-size:12px; font-family:Inter,sans-serif; text-align:center; min-height:18px; margin-top:6px; font-weight:500; transition:all 0.2s;';
        const buttonWrapper = form.querySelector('.framer-14v1qha-container') || submitBtn;
        if (buttonWrapper && buttonWrapper.parentNode) {
          buttonWrapper.parentNode.insertBefore(statusText, buttonWrapper.nextSibling);
        }
      }

      function setStatus(msg, isError) {
        if (!statusText) return;
        statusText.textContent = msg;
        statusText.style.color = isError ? '#ef4444' : '#10b981';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const nameInput = form.querySelector('input[name="Name"]') || form.querySelector('input[name="name"]');
        const emailInput = form.querySelector('input[name="Email"]') || form.querySelector('input[name="email"]');
        const passwordInput = form.querySelector('input[name="password"]') || form.querySelectorAll('input[type="password"]')[0];
        const confirmPwInput = form.querySelector('input[name="confirmPassword"]') || form.querySelectorAll('input[type="password"]')[1];

        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value : '';
        const confirmPassword = confirmPwInput ? confirmPwInput.value : '';

        if (!name || name.length < 3) {
          setStatus('Username must be at least 3 characters', true);
          if (nameInput) nameInput.focus();
          return;
        }

        if (!email || !email.includes('@')) {
          setStatus('Please enter a valid email address', true);
          if (emailInput) emailInput.focus();
          return;
        }

        if (!password || password.length < 8) {
          setStatus('Password must be at least 8 characters', true);
          if (passwordInput) passwordInput.focus();
          return;
        }

        if (password !== confirmPassword) {
          setStatus('Passwords do not match', true);
          if (confirmPwInput) confirmPwInput.focus();
          return;
        }

        // Submitting
        setStatus('', false);
        if (submitSpan) submitSpan.textContent = 'Deploying workspace...';

        try {
          const res = await fetch('http://localhost:3000/api/auth/signup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, password, confirmPassword })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (statusText) statusText.textContent = '';
            if (window.nuanceNavigate) {
              window.nuanceNavigate('/login');
            } else {
              window.location.href = '/login';
            }
          } else {
            if (submitSpan) submitSpan.textContent = originalBtnText;
            setStatus(data.error || 'Failed to create account.', true);
          }
        } catch (err) {
          if (submitSpan) submitSpan.textContent = originalBtnText;
          setStatus('Could not connect to auth server.', true);
        }
      }, true);
    }

    setupFormHook();
    const observer = new MutationObserver(setupFormHook);
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

<script is:inline>
  function replaceBrand(node) {
    if (node.nodeType === 3 && node.nodeValue && node.nodeValue.includes('Warpyn')) {
      node.nodeValue = node.nodeValue.replaceAll('Warpyn', 'Nuance');
    } else if (node.nodeType === 1 && node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE') {
      for (const ch of node.childNodes) replaceBrand(ch);
    }
  }
  if (document.body) replaceBrand(document.body);
  new MutationObserver((muts) => {
    for (const m of muts) {
      if (m.type === 'childList') m.addedNodes.forEach(replaceBrand);
      else if (m.type === 'characterData') replaceBrand(m.target);
    }
  }).observe(document.documentElement, { childList: true, subtree: true, characterData: true });
</script>
