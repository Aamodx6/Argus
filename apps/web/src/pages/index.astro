<script is:inline define:vars={{ textMap }}>
  function update(node) {
    if (node.nodeType === 3) {
      let v = node.nodeValue;
      for (const [f, t] of textMap) {
        if (v.includes(f)) v = v.replaceAll(f, t);
      }
      if (v !== node.nodeValue) node.nodeValue = v;
    } else if (node.nodeType === 1 && node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE') {
      for (const c of node.childNodes) update(c);
    }
  }
  function fixLinks() {
    document.querySelectorAll('a').forEach(a => {
      const text = a.textContent?.trim();
      if (text === 'Sign In' || text === 'Sign in') {
        a.href = '/login';
      } else if (text === 'Connect a source' || text === 'Analyze a video' || text === 'Start analysis' || text === 'Start weaving') {
        a.href = '/console';
      } else if (text === 'Book a 20-minute demo' || text === 'Create your free API key') {
        a.href = '/contact';
      }
    });
  }
  if (document.body) {
    update(document.body);
    fixLinks();
  }
  const obs = new MutationObserver((muts) => {
    for (const m of muts) {
      if (m.type === 'childList') m.addedNodes.forEach(update);
      else if (m.type === 'characterData') update(m.target);
    }
    fixLinks();
  });
  obs.observe(document.documentElement, { childList: true, subtree: true, characterData: true });
</script>
